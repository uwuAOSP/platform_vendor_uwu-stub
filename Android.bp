    sdk_version: "current",
    installable: false,
}

java_library {
    name: "com_android_car_settings_flags_lib",
    srcs: ["stubs/packages/apps/Car/Settings/aconfig/CarSettingsFlagsStub.java"],
    sdk_version: "current",
    installable: false,
}

test_suite_package {
    name: "automotive-tests",
}

test_suite_package {
    name: "automotive-general-tests",
}

cc_defaults {
    name: "android-automotive-large-parcelable-defaults",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library {
    name: "android-automotive-large-parcelable-lib",
    srcs: ["stubs/shared/AutomotiveStub.cpp"],
    defaults: ["android-automotive-large-parcelable-defaults"],
    vendor_available: true,
    host_supported: true,
}

cc_defaults {
    name: "powerpolicyclient_defaults",
}

cc_library {
    name: "libpowerpolicyclient",
    srcs: ["stubs/shared/AutomotiveStub.cpp"],
    vendor_available: true,
    system_ext_specific: true,
}

cc_defaults {
    name: "vhalclient_defaults",
}

cc_library {
    name: "libvhalclient",
    srcs: ["stubs/shared/AutomotiveStub.cpp"],
    vendor_available: true,
}

cc_defaults {
    name: "carwatchdogd_defaults",
}

cc_defaults {
    name: "libwatchdog_perf_service_defaults",
}

cc_library {
    name: "libwatchdog_perf_service",
    srcs: ["stubs/shared/AutomotiveStub.cpp"],
    vendor_available: true,
}

cc_library {
    name: "android.automotive.watchdog-V2-ndk",
    srcs: ["stubs/shared/AutomotiveStub.cpp"],
    vendor_available: true,
}
